# All paths are resolved from D:\Project\PayTracker. Relative paths are recommended.
PAYTRACKER_DATABASE_URL=sqlite:///data/paytracker.db
PAYTRACKER_TESSERACT_CMD=
PAYTRACKER_MAX_UPLOAD_MB=20
PAYTRACKER_CURRENCY=AUD
PAYTRACKER_TIME_FORMAT=24h
PAYTRACKER_RETAIN_UPLOADS=true
PAYTRACKER_BACKUP_LOCATION=backups

